// Corrected version of the original Day 07 multibranch Jenkinsfile (original kept as "Jenkinsfile").
// ⚠️ Fixes: (1) deploy to port 5000 / push :latest ONLY from main, (2) PRs get an isolated, throwaway preview,
// (3) tag images by commit SHA because BUILD_NUMBER restarts in every branch/PR job, (4) cleanup in post.
pipeline {
    agent any
    options {
        disableConcurrentBuilds(abortPrevious: true)
        timeout(time: 30, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }
    environment {
        IMAGE = "docker.io/cloudwithvarjosh/cwvj-flask"   // change to YOUR Docker Hub namespace/repo
    }
    stages {
        stage('meta') {
            steps {
                script { env.TAG = env.GIT_COMMIT.take(7) }
                echo "Branch ${env.BRANCH_NAME}, image tag ${env.TAG}"
            }
        }
        stage('build') {
            steps {
                sh 'docker build -t "$IMAGE:$TAG" .'
            }
        }
        stage('push') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'dockerhub', passwordVariable: 'DOCKERHUB_PWD', usernameVariable: 'DOCKERHUB_USER')]) {
                    sh 'echo "$DOCKERHUB_PWD" | docker login -u "$DOCKERHUB_USER" --password-stdin'
                    sh 'docker push "$IMAGE:$TAG"'
                    script {
                        if (env.BRANCH_NAME == 'main') {
                            sh 'docker tag "$IMAGE:$TAG" "$IMAGE:latest" && docker push "$IMAGE:latest"'
                        }
                    }
                }
            }
        }
        stage('deploy main') {
            when { branch 'main' }
            steps {
                sh 'docker rm -f cwvj-flask || true'
                sh 'docker run -d --name cwvj-flask -p 5000:5000 "$IMAGE:$TAG"'
                sh '''
                  cat > deploy-info-$BUILD_NUMBER.txt <<EOF
build: $BUILD_NUMBER
image: $IMAGE:$TAG
commit: ${GIT_COMMIT}
branch: $BRANCH_NAME
time: $(date -u +"%Y-%m-%dT%H:%M:%SZ")
url: $BUILD_URL
EOF
                '''
                archiveArtifacts artifacts: "deploy-info-${BUILD_NUMBER}.txt", fingerprint: true, followSymlinks: false
                sh 'docker run --rm --network container:cwvj-flask curlimages/curl -fsS --retry 5 --retry-connrefused http://localhost:5000'
            }
        }
        stage('preview PR') {
            when { changeRequest() }
            steps {
                sh 'docker rm -f "pr-$CHANGE_ID" || true'
                sh 'docker run -d --name "pr-$CHANGE_ID" "$IMAGE:$TAG"'      // no host port: it can't clash with main
                sh 'docker run --rm --network "container:pr-$CHANGE_ID" curlimages/curl -fsS --retry 5 --retry-connrefused http://localhost:5000'
            }
            post {
                always { sh 'docker rm -f "pr-$CHANGE_ID" || true' }
            }
        }
    }
    post {
        success { echo "Build ${env.BUILD_NUMBER} succeeded" }
        failure { echo "Build ${env.BUILD_NUMBER} failed" }
        always  { echo "Build ${env.BUILD_NUMBER} finished" }
        cleanup { cleanWs() }
    }
}
