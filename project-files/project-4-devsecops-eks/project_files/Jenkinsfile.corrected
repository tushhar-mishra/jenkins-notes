// Corrected version of the original Project 01 Jenkinsfile (original kept as "Jenkinsfile").
// Fixes:
//  - BuildKit instead of the deprecated legacy builder (removed `export DOCKER_BUILDKIT=0`)
//  - `set -euo pipefail` (the #!/bin/bash -l shebang disables Jenkins' default -e)
//  - credential ID kept as 'sonarqube-token' everywhere (the README snippets used 'sonarqube-token-new')
//  - SonarQube referenced by DNS name instead of a private IP that changed between runs (set SONAR_HOST to yours)
//  - timeouts, timestamps, build discarder; workspace cleanup in post
// Audit fixes:
//  - Sonar token goes to Maven through the SONAR_TOKEN environment variable, NOT -Dsonar.token=...
//    (command-line arguments are visible to every user on the agent via `ps`), and SonarQube is reached over HTTPS.
//  - Build once, deploy by DIGEST: the exact image that was scanned and pushed is the one that runs.
//    No :latest push (it can't be immutable in ECR and says nothing about what is deployed).
//  - The manifest edit changes ONLY the app's image line (the old `s|image:.*|` rewrote every image: line).
//  - Namespace is created once by a cluster admin; the pipeline's RBAC is namespaced (clusterrole-binding.yaml).
//  - `docker logout` from ECR in post, so the registry token doesn't stay on the shared agent.
//  Still TODO for production (see notes 59-64): SBOM + cosign signing, admission verification,
//  OIDC/per-job credentials instead of the agent's instance role, and an approval gate before prod.
pipeline {
    agent { label 'docker-maven-trivy' }
    options {
        timeout(time: 45, unit: 'MINUTES')
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '20'))
        disableConcurrentBuilds()
    }
    tools {
        maven 'maven3'
    }
    environment {
        SONAR_HOST   = 'https://sonarqube.internal'          // HTTPS; use your DNS name
        AWS_REGION   = 'ap-south-1'
        EKS_CLUSTER  = 'cwvj-devsecops-eks'
        ECR_REGISTRY = '<YOUR_ACCOUNT_ID>.dkr.ecr.ap-south-1.amazonaws.com'
        IMAGE_REPO   = "${ECR_REGISTRY}/cwvj-devsecops-demo"
        NAMESPACE    = 'cwvj-devsecops'
        APP          = 'cwvj-devsecops-demo'
    }
    stages {
        stage('Trivy FS Scan') {
            steps {
                sh 'trivy fs --scanners vuln,secret,misconfig --exit-code 1 --severity HIGH,CRITICAL .'
            }
        }
        stage('Build & Sonar') {
            steps {
                // SONAR_TOKEN is read from the environment by the Sonar Maven plugin: it never appears in `ps`.
                withCredentials([string(credentialsId: 'sonarqube-token', variable: 'SONAR_TOKEN')]) {
                    sh '''
                      mvn -B clean verify sonar:sonar \
                        -Dsonar.projectKey=cwvj-devsecops-demo \
                        -Dsonar.host.url="$SONAR_HOST" \
                        -Dsonar.qualitygate.wait=true
                    '''
                }
            }
            post {
                always { junit allowEmptyResults: true, testResults: 'target/surefire-reports/*.xml' }
            }
        }
        stage('Build Image') {
            steps {
                sh 'docker build --platform linux/amd64 -t "$IMAGE_REPO:$BUILD_NUMBER" .'
            }
        }
        stage('Trivy Image Scan') {
            steps {
                sh 'trivy image --exit-code 1 --severity HIGH,CRITICAL "$IMAGE_REPO:$BUILD_NUMBER"'
            }
        }
        stage('Push to ECR') {
            steps {
                sh '''
                  set -euo pipefail
                  aws ecr get-login-password --region "$AWS_REGION" | docker login --username AWS --password-stdin "$ECR_REGISTRY"
                  docker push "$IMAGE_REPO:$BUILD_NUMBER"
                  # The registry digest of what we just pushed: deploy THIS, not a tag.
                  docker inspect --format='{{index .RepoDigests 0}}' "$IMAGE_REPO:$BUILD_NUMBER" > image.ref
                  echo "Deploying $(cat image.ref)"
                '''
                archiveArtifacts artifacts: 'image.ref', fingerprint: true
            }
        }
        stage('Update Deployment') {
            steps {
                // Change only the line for OUR image (sidecars or other images stay untouched).
                sh '''
                  set -euo pipefail
                  REF=$(cat image.ref)
                  sed -i -E "s|^([[:space:]]*image:[[:space:]]*).*/${APP}([:@].*)?$|\1${REF}|" deploy-svc.yaml
                  grep -n "image:" deploy-svc.yaml
                  grep -q "image: ${REF}" deploy-svc.yaml   # fail if the edit didn't happen
                '''
            }
        }
        stage('Deploy to Kubernetes') {
            steps {
                sh '''#!/bin/bash -l
set -euo pipefail
aws eks update-kubeconfig --region "$AWS_REGION" --name "$EKS_CLUSTER"

# The namespace is created once by a cluster admin; this pipeline's RBAC is limited to it.
kubectl apply -n "$NAMESPACE" -f deploy-svc.yaml

if ! kubectl rollout status -n "$NAMESPACE" "deployment/$APP" --timeout=180s; then
  kubectl rollout undo -n "$NAMESPACE" "deployment/$APP" || true
  exit 1
fi
'''
            }
        }
    }
    post {
        success { echo "Build ${env.BUILD_NUMBER} succeeded" }
        failure { echo "Build ${env.BUILD_NUMBER} failed" }
        always  { echo "Build ${env.BUILD_NUMBER} finished" }
        cleanup {
            sh 'docker logout "$ECR_REGISTRY" || true'
            sh 'docker image rm "$IMAGE_REPO:$BUILD_NUMBER" || true'
            cleanWs()
        }
    }
}
